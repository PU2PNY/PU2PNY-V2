#!/bin/sh
# PU2PNY-V2 lean Stage 2: AP + pu2pnyd-lean panel daemon (serves /www + /api).
start() {
	printf 'PU2PNY-V2 Stage2: AP + panel daemon... '
	/usr/local/sbin/pu2pny-ap start || { echo "AP FAIL"; return 1; }
	PU2PNY_WWW=/www /usr/local/bin/pu2pnyd-lean >/var/log/pu2pnyd-lean.log 2>&1 &
	echo "OK (SSID PU2PNY-V2, http://10.43.0.1, panel daemon live)"
}
stop() {
	killall pu2pnyd-lean 2>/dev/null
	/usr/local/sbin/pu2pny-ap stop
}
case "${1:-}" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
