# PU2PNY-V2 lean Stage 2 — on top of raspberrypi4_defconfig.
# Stage-1 AP packages + wpa_supplicant for the WiFi wizard (join home network).
BR2_TARGET_GENERIC_HOSTNAME="pu2pny-v2"
BR2_TARGET_GENERIC_ISSUE="PU2PNY-V2 TEST (Buildroot lean Stage 2 - NOT approved)"
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
