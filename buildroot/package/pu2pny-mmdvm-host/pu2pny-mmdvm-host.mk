PU2PNY_MMDVM_HOST_VERSION = 590c531391dfd3146073afbc3956f70d42c62a46
PU2PNY_MMDVM_HOST_SITE = $(call github,g4klx,MMDVM-Host,$(PU2PNY_MMDVM_HOST_VERSION))
PU2PNY_MMDVM_HOST_SOURCE = MMDVM-Host-$(PU2PNY_MMDVM_HOST_VERSION).tar.gz
PU2PNY_MMDVM_HOST_LICENSE = GPL-2.0+
PU2PNY_MMDVM_HOST_LICENSE_FILES = LICENCE
PU2PNY_MMDVM_HOST_DEPENDENCIES = mosquitto json-for-modern-cpp

define PU2PNY_MMDVM_HOST_BUILD_CMDS
	printf 'const char *gitversion = "%s";\n' '$(PU2PNY_MMDVM_HOST_VERSION)' > $(@D)/GitVersion.h
	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) -o GitVersion.h \
		CXX="$(TARGET_CXX)" CFLAGS="$(TARGET_CXXFLAGS) -std=c++17 -pthread -MMD -MD" \
		LDFLAGS="$(TARGET_LDFLAGS)" MMDVM-Host
endef

define PU2PNY_MMDVM_HOST_INSTALL_TARGET_CMDS
	$(INSTALL) -D -m 0755 $(@D)/MMDVM-Host $(TARGET_DIR)/usr/local/bin/MMDVM-Host
endef

$(eval $(generic-package))
