PU2PNY_MMDVM_DISPLAY_VERSION = 96a0705d818c4234960a61dd2837e32f9450f811
PU2PNY_MMDVM_DISPLAY_SITE = $(call github,g4klx,MMDVM-Display,$(PU2PNY_MMDVM_DISPLAY_VERSION))
PU2PNY_MMDVM_DISPLAY_SOURCE = MMDVM-Display-$(PU2PNY_MMDVM_DISPLAY_VERSION).tar.gz
PU2PNY_MMDVM_DISPLAY_LICENSE = GPL-2.0+
PU2PNY_MMDVM_DISPLAY_LICENSE_FILES = LICENSE
PU2PNY_MMDVM_DISPLAY_DEPENDENCIES = mosquitto json-for-modern-cpp

define PU2PNY_MMDVM_DISPLAY_BUILD_CMDS
	printf 'const char *gitversion = "%s";\n' '$(PU2PNY_MMDVM_DISPLAY_VERSION)' > $(@D)/GitVersion.h
	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) -o GitVersion.h \
		CXX="$(TARGET_CXX)" CFLAGS="$(TARGET_CXXFLAGS) -std=c++11 -pthread -MMD -MD" \
		LDFLAGS="$(TARGET_LDFLAGS)" MMDVM-Display
endef

define PU2PNY_MMDVM_DISPLAY_INSTALL_TARGET_CMDS
	$(INSTALL) -D -m 0755 $(@D)/MMDVM-Display $(TARGET_DIR)/usr/local/bin/MMDVM-Display
endef

$(eval $(generic-package))
