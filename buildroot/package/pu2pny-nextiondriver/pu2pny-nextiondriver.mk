PU2PNY_NEXTIONDRIVER_VERSION = 03b904270c9cb54f720d71753fc209afb1d9598f
PU2PNY_NEXTIONDRIVER_SITE = $(call github,on7lds,NextionDriver,$(PU2PNY_NEXTIONDRIVER_VERSION))
PU2PNY_NEXTIONDRIVER_SOURCE = NextionDriver-$(PU2PNY_NEXTIONDRIVER_VERSION).tar.gz
PU2PNY_NEXTIONDRIVER_LICENSE = GPL-2.0+
PU2PNY_NEXTIONDRIVER_LICENSE_FILES = basicFunctions.h
PU2PNY_NEXTIONDRIVER_DEPENDENCIES = host-python3

define PU2PNY_NEXTIONDRIVER_HARDEN
	$(HOST_DIR)/bin/python3 $(BR2_EXTERNAL_PU2PNY_V2_PATH)/../ci/harden-nextiondriver-0.3.31.118.py $(@D)
endef

PU2PNY_NEXTIONDRIVER_PRE_CONFIGURE_HOOKS += PU2PNY_NEXTIONDRIVER_HARDEN

define PU2PNY_NEXTIONDRIVER_BUILD_CMDS
	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) CC="$(TARGET_CC)" \
		CFLAGS="$(TARGET_CFLAGS) $(TARGET_LDFLAGS) -D_GNU_SOURCE" NextionDriver
endef

define PU2PNY_NEXTIONDRIVER_INSTALL_TARGET_CMDS
	$(INSTALL) -D -m 0755 $(@D)/NextionDriver $(TARGET_DIR)/usr/local/bin/NextionDriver-pu2pny
endef

$(eval $(generic-package))
